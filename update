#!/bin/sh
set -e
export LC_ALL=C

BUILD_DIR="$(pwd)"
MPV_DIR="$BUILD_DIR/mpv"
UPSTREAM_MPV="https://github.com/mpv-player/mpv.git"
FORK_MPV="https://github.com/Halffd/mpv.git"
FORK_BRANCH="sub-stacking"

do_clone()
{
    set -ex
    if ! test -e "$1" ; then
        git clone "$2" "$1"
    fi
    (
        cd "$1"
        git remote set-url origin "$2"
        git fetch
        git submodule update --init
    )
}

do_clone_all()
{
    do_clone "ffmpeg"     "https://github.com/FFmpeg/FFmpeg.git"
    do_clone "libass"     "https://github.com/libass/libass.git"
    do_clone "libplacebo" "https://github.com/haasn/libplacebo.git"
    do_clone "mpv"        "$FORK_MPV"
}

versort_with_prefix()
{
    sed -n -e "s/^$1\([0-9]\)/\1/p" |\
        sort -n -t . -k 1,1 -k 2,2 -k 3,3 -k 4,4 |\
        sed -e "s/^/$1/"
}

do_gitmaster()
{
    set -ex
    (
        cd "$1"
        git checkout origin/master
        git remote prune origin
    )
}

do_releasetag()
{
    local prefix=
    case "$1" in
        ffmpeg) prefix=n;;
        mpv|libplacebo)    prefix=v;;
    esac

    (
        cd "$1"
        version=`git tag | grep -v rc | grep -v dev | versort_with_prefix "$prefix" | tail -n 1`
        git checkout refs/tags/"$version"
    )
}

do_fixedref()
{
    (
        cd "$1"
        git checkout "$2"
    )
}

checkout()
{
    local branch="$2"
    if [ -z "$3" ] && [ -d config/ ] && [ -f config/branch-$1 ]; then
        branch="$(cat config/branch-$1)"
    fi

    case "$branch" in
        master)  do_gitmaster $1;;
        release) do_releasetag $1;;
        @*)      do_fixedref $1 "${branch#@}";;
        *)       >&2 printf "%s\n" "Error: Don't know how to checkout '$branch'"
                 return 1
    esac
}

checkout_ffmpeg=master
checkout_libass=master
checkout_libplacebo=master
checkout_mpv=master

checkout_all()
{
    set -ex
    do_clone_all
    checkout ffmpeg $checkout_ffmpeg
    checkout libass $checkout_libass
    checkout libplacebo $checkout_libplacebo
    checkout mpv $checkout_mpv
}

do_update_debian_versions()
{
  scripts/debian-update-versions $1
}

if [ x"$1" != x"--skip-selfupdate" ]; then
    (
        set -ex
        git pull --rebase
    )
    exec "$0" --skip-selfupdate "$@"
fi
shift

case "$1" in
    --master)
        checkout_ffmpeg="master -"
        checkout_libass="master -"
        checkout_libplacebo="master -"
        checkout_mpv="master -"
        ;;
    --release)
        checkout_ffmpeg="release -"
        checkout_mpv="release -"
        ;;
    --fork)
        checkout_mpv="@$FORK_BRANCH -"
        ;;
    '')
        ;;
    *)
        echo >&2 "$0 [--master|--release|--fork]"
        exit 0
        ;;
esac

checkout_all

do_update_debian_versions

# Apply patches
apply_patches() {
    set +e
    if [ -f "$BUILD_DIR/subs-bottom-stacking.patch" ]; then
        echo "Applying subs-bottom-stacking patch..."
        cd "$MPV_DIR"
        if ! grep -q "sub-bottom-stacking" options/options.h 2>/dev/null; then
            git apply --ignore-whitespace --ignore-space-change "$BUILD_DIR/subs-bottom-stacking.patch" 2>/dev/null
            if [ $? -eq 0 ]; then
                echo "Patch applied successfully."
            else
                echo "Warning: Failed to apply patch."
            fi
        else
            echo "Patch already applied, skipping."
        fi
        cd "$BUILD_DIR"
    fi
}

apply_patches

# Auto-merge upstream into fork branch
auto_merge_fork() {
    echo "=== Auto-merging upstream into fork branch ==="
    cd "$MPV_DIR"
    
    # Add upstream if not present
    git remote | grep -q upstream || git remote add upstream "$UPSTREAM_MPV"
    
    # Fetch both
    git fetch upstream
    git fetch origin
    
    # Ensure we're on the fork branch
    git checkout "$FORK_BRANCH" 2>/dev/null || git checkout -b "$FORK_BRANCH" origin/"$FORK_BRANCH"
    
    # Rebase onto upstream/master
    echo "Rebasing $FORK_BRANCH onto upstream/master..."
    if git rebase upstream/master; then
        echo "Rebase successful. Pushing to fork..."
        git push origin "$FORK_BRANCH" --force-with-lease
    else
        echo "Rebase conflict. Attempting merge..."
        git rebase --abort
        if git merge upstream/master --no-edit; then
            echo "Merge successful. Pushing to fork..."
            git push origin "$FORK_BRANCH" --force-with-lease
        else
            echo "ERROR: Merge failed. Manual resolution required."
            exit 1
        fi
    fi
    cd "$BUILD_DIR"
}

case "$1" in
    --merge-fork)
        auto_merge_fork
        ;;
    --full)
        auto_merge_fork
        echo "=== Rebuilding all ==="
        ./scripts/libplacebo-config && ./scripts/libplacebo-build
        ./scripts/libass-config && ./scripts/libass-build
        ./scripts/ffmpeg-config && ./scripts/ffmpeg-build
        ./scripts/mpv-config && ./scripts/mpv-build
        ;;
esac

echo "=== Update complete ==="