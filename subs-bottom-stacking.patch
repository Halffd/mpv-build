diff --git a/sub/osd.c b/sub/osd.c
index 2788897396..6596f4ea37 100644
--- a/sub/osd.c
+++ b/sub/osd.c
@@ -414,6 +414,85 @@ struct sub_bitmap_list *osd_render(struct osd_state *osd, struct mp_osd_res res,
         talloc_free(imgs);
     }

+    // If subtitle bottom stacking is enabled, adjust positions so secondary
+    // subtitles appear above primary subtitles at the bottom of the screen
+    if (osd->opts->sub_bottom_stacking) {
+        struct sub_bitmaps *primary_bitmaps = NULL;
+        struct sub_bitmaps *secondary_bitmaps = NULL;
+
+        // Find primary and secondary subtitle bitmaps
+        for (int n = 0; n < list->num_items; n++) {
+            struct sub_bitmaps *imgs = list->items[n];
+            if (imgs->render_index == OSDTYPE_SUB) {
+                primary_bitmaps = imgs;
+            } else if (imgs->render_index == OSDTYPE_SUB2) {
+                secondary_bitmaps = imgs;
+            }
+        }
+
+        // If we have both primary and secondary subtitles, adjust positioning for stacking
+        if (primary_bitmaps && secondary_bitmaps) {
+            // Calculate actual height occupied by each subtitle track
+            int primary_min_y = list->h, primary_max_y = 0;
+            int secondary_min_y = list->h, secondary_max_y = 0;
+
+            for (int i = 0; i < primary_bitmaps->num_parts; i++) {
+                struct sub_bitmap *bi = &primary_bitmaps->parts[i];
+                int top_y = bi->y;
+                int bottom_y = bi->y + bi->dh;
+                if (top_y < primary_min_y) primary_min_y = top_y;
+                if (bottom_y > primary_max_y) primary_max_y = bottom_y;
+            }
+            int primary_height = primary_max_y - primary_min_y;
+
+            for (int i = 0; i < secondary_bitmaps->num_parts; i++) {
+                struct sub_bitmap *bi = &secondary_bitmaps->parts[i];
+                int top_y = bi->y;
+                int bottom_y = bi->y + bi->dh;
+                if (top_y < secondary_min_y) secondary_min_y = top_y;
+                if (bottom_y > secondary_max_y) secondary_max_y = bottom_y;
+            }
+            int secondary_height = secondary_max_y - secondary_min_y;
+
+            // Position both subtitles at the bottom of the screen, with secondary above primary
+            int margin = 5; // Small margin between subtitles
+
+            // Check if both subtitles can fit at the bottom
+            int total_required_height = primary_height + secondary_height + margin;
+            int bottom_y = list->h - 10; // Leave some margin from actual bottom
+
+            // If they can't both fit at the bottom, position them starting from the top
+            if (total_required_height > bottom_y) {
+                // Position primary subtitle at top
+                int new_primary_y = 10; // Start from top with margin
+                int primary_adjustment = new_primary_y - primary_min_y;
+
+                // Position secondary subtitle below the primary
+                int new_secondary_y = new_primary_y + primary_height + margin;
+                int secondary_adjustment = new_secondary_y - secondary_min_y;
+            } else {
+                // Position primary subtitle near the bottom
+                int new_primary_y = bottom_y - primary_height;
+                int primary_adjustment = new_primary_y - primary_min_y;
+
+                // Position secondary subtitle above the primary
+                int new_secondary_y = new_primary_y - secondary_height - margin;
+                int secondary_adjustment = new_secondary_y - secondary_min_y;
+            }
+
+            // Apply adjustments to all subtitle parts
+            for (int i = 0; i < primary_bitmaps->num_parts; i++) {
+                struct sub_bitmap *bi = &primary_bitmaps->parts[i];
+                bi->y += primary_adjustment;
+            }
+
+            for (int i = 0; i < secondary_bitmaps->num_parts; i++) {
+                struct sub_bitmap *bi = &secondary_bitmaps->parts[i];
+                bi->y += secondary_adjustment;
+            }
+        }
+    }
+
     double elapsed = MP_TIME_NS_TO_MS(mp_time_ns() - start_time);
     bool slow = elapsed > 5;
     mp_msg(osd->log, slow ? MSGL_DEBUG : MSGL_TRACE, "Spent %.3f ms in %s%s\n",
